{
  "name": "monitor-sync",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Dev-only tool: regenerates monitor.js.patch and bumps upstream version refs via AST-based (tree-sitter) semantic patching. Never copied into the runtime Docker image.",
  "bin": {
    "monitor-sync": "./bin/sync.js"
  },
  "scripts": {
    "sync": "node bin/sync.js",
    "test": "node --test test/*.test.js",
    "verify": "node bin/sync.js patch --to 2.4.0 --repo-root ../.. --dry-run"
  },
  "dependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1"
  },
  "allowScripts": {
    "tree-sitter@0.21.1": true,
    "tree-sitter-javascript@0.23.1": true
  }
}
